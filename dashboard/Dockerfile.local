# TEST-ONLY: dipakai di mesin lokal yg jaringan container ke npm registry lambat.
# Menyalin node_modules dari host (bukan bun install di dalam container).
# Produksi TETAP pakai Dockerfile (bun install --frozen-lockfile).
FROM oven/bun:1.3-alpine AS builder
WORKDIR /app
COPY node_modules ./node_modules
COPY . .
ARG NEXT_PUBLIC_WORKER_URL
ARG NEXT_PUBLIC_WORKER_URLS
ENV NEXT_PUBLIC_WORKER_URL=$NEXT_PUBLIC_WORKER_URL
ENV NEXT_PUBLIC_WORKER_URLS=$NEXT_PUBLIC_WORKER_URLS
RUN bun run build

FROM oven/bun:1.3-alpine AS runner
WORKDIR /app
ENV NODE_ENV=production
COPY --from=builder /app/.next ./.next
COPY --from=builder /app/public ./public
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/package.json ./package.json
COPY --from=builder /app/next.config.ts ./next.config.ts
EXPOSE 3000
CMD ["bun", "run", "start"]
