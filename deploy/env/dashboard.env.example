# Dashboard di-host di SATU VPS (mis. VPS node1).
# NEXT_PUBLIC_* di-inline saat build — jika worker URLs berubah, rebuild image.
# DASH_DOMAIN=... (wajib, untuk HTTPS otomatis via Let's Encrypt)
NEXT_PUBLIC_WORKER_URL=https://worker1.example.com
NEXT_PUBLIC_WORKER_URLS=https://worker1.example.com,https://worker2.example.com,https://worker3.example.com
DASH_DOMAIN=dashboard.example.com
