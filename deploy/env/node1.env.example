# =============================================================
# Contoh env untuk NODE 1 dari 3. Salin ke root repo sebagai .env:
#   cp deploy/env/node1.env.example .env
# JWT_SECRET dan INTERNAL_TOKEN WAJIB SAMA di ketiga node.
# Ganti PG_PASSWORD, IP VPS, dan hostname di bawah.
# =============================================================
NODE_ENV=production
WORKER_ID=setor-1

# Bind worker (default 3101 di semua node)
WORKER_PORT=3101
PUBLIC_URL=http://<IP_VPS_1>:3101
PEER_SEEDS=http://<IP_VPS_2>:3101,http://<IP_VPS_3>:3101

# Postgres container pada VPS ini (password bebas, beda tiap node boleh)
PG_USER=setor
PG_PASSWORD=<generate-acak>
PG_SHARED_DB=setor_shared
DATABASE_URL=postgres://setor:<PG_PASSWORD>@postgres:5432/setor_shared
LOCAL_DATABASE_URL=postgres://setor:<PG_PASSWORD>@postgres:5432/setor_local

# Auth — HASILKAN KUAT & SAMA DI SEMUA NODE:
#   openssl rand -base64 48
JWT_SECRET=<SAMA-di-3-node>
INTERNAL_TOKEN=<SAMA-di-3-node>

CORS_ORIGINS=https://dashboard.example.com,http://localhost:3000

# (Opsional) profile proxy -> TLS
# WORKER_DOMAIN=worker1.example.com